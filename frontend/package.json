{
    "name": "sharefolio",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run type-check && npm run build-only",
        "preview": "vite preview --port 4173",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --ext .js,.ts,.vue,.jsx,.tsx,.cjs,.mjs --fix",
        "lint:nofix": "eslint . --ext .js,.ts,.vue,.jsx,.tsx,.cjs,.mjs",
        "lint:style": "stylelint '**/*.scss'",
        "format": "prettier --write src/",
        "test": "vitest",
        "test:nowatch": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "cypress run --e2e",
        "test:e2e:dev": "cypress open --e2e"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-regular-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/vue-fontawesome": "^3.3.3",
        "@lottiefiles/dotlottie-vue": "^0.11.24",
        "@primevue/themes": "^4.5.4",
        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "@vueuse/core": "^11.3.0",
        "axios": "^1.19.0",
        "happy-dom": "^6.0.4",
        "js-cookie": "^3.0.8",
        "material-icons": "^1.13.12",
        "pinia": "^2.3.1",
        "primevue": "^4.0.0",
        "vue": "^3.5.41",
        "vue-i18n": "^9.14.5",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@intlify/unplugin-vue-i18n": "^4.0.0",
        "@tsconfig/node20": "^20.1.4",
        "@types/js-cookie": "^3.0.6",
        "@types/jsdom": "^21.1.7",
        "@types/node": "^20.14.5",
        "@typescript-eslint/eslint-plugin": "^7.13.1",
        "@typescript-eslint/parser": "^7.13.1",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vitest/coverage-istanbul": "^1.6.0",
        "@vue/eslint-config-prettier": "^9.0.0",
        "@vue/eslint-config-typescript": "^13.0.0",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.5.1",
        "autoprefixer": "^10.4.18",
        "cypress": "^13.17.0",
        "eslint": "^8.57.0",
        "eslint-plugin-vue": "^9.22.0",
        "jsdom": "^24.1.0",
        "postcss": "^8.4.35",
        "prettier-plugin-tailwindcss": "^0.5.12",
        "sass": "^1.102.0",
        "stylelint": "^16.26.1",
        "stylelint-config-standard": "^36.0.0",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.9.3",
        "vite": "^5.4.21",
        "vitest": "^1.6.1",
        "vue-tsc": "^2.2.12"
    }
}
