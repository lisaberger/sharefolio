{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "env.d.ts",
        "src/**/*",
        "src/**/*.vue"
    ],
    "exclude": [
        "src/**/__tests__/*"
    ],
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@ui/*": [
                "./src/ui/*"
            ],
            "@core": [
                "./src/core/index.ts"
            ],
            "@core/*": [
                "./src/core/*"
            ],
            "@config": [
                "./src/config/index.ts"
            ],
            "@config/*": [
                "./src/config/*"
            ],
            "@api": [
                "./src/api/index.ts"
            ],
            "@api/*": [
                "./src/api/*"
            ]
        }
    }
}