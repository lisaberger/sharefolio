    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.10.2",
        "@types/pg": "^8.11.10",
        "@types/supertest": "^6.0.2",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.6",
        "nodemon": "^3.1.14",
        "supertest": "^7.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.9.3",
        "vitest": "^2.1.8"
