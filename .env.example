# Copy to .env, .env.staging or .env.prod and adjust for your environment.

# Database name baked into the postgres image.
WEB_DB=sharefolio

# Host path to the Docker socket (macOS Docker Desktop uses ~/.docker/run/docker.sock).
DOCKER_SOCKET=/var/run/docker.sock

# Hostnames routed by Traefik.
UI_HOST=ui.sharefolio.local
API_HOST=api.sharefolio.local
ADMINER_HOST=adminer.sharefolio.local

# Hostnames the Vite dev server accepts (comma-separated).
UI_HOSTS=${UI_HOST},localhost

# Base URL the frontend uses to reach the API.
BACKEND_URL=http://api.sharefolio.local

# Name of the environment (shown in the Swagger docs).
ENV_NAME=Development
